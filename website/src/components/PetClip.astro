---
// A pet's clip, its idle one unless named, looping while on screen;
// src/scripts/clips.ts plays it.
// Safari takes the HEVC .mov with alpha, the others the WebM.
import { url } from '../url';

interface Props {
	id: string;
	clip?: string;
	width: number;
	height: number;
	class?: string;
	style?: string;
}
const { id, clip = 'idle', width, height, class: className, style } = Astro.props;
---

<video data-clip muted loop playsinline preload="none" width={width} height={height} class={className} style={style} aria-hidden="true">
	<source src={url(`clips/${id}/${clip}.mov`)} type='video/quicktime; codecs="hvc1"' />
	<source src={url(`clips/${id}/${clip}.webm`)} type="video/webm" />
</video>

<script>
	import '../scripts/clips';
</script>
