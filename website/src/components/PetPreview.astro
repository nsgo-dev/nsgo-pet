---
// A pet's idle clip, small, for a row of a docs table. It carries the pet's
// ID as its anchor, so the home page's cards can lead to the row.
import PetClip from './PetClip.astro';
import { loadPets } from '../pets';

interface Props {
	id: string;
}
const { id } = Astro.props;
const pet = loadPets().find((p) => p.id === id);
if (!pet) throw new Error(`no pet ${id}`);
---

<span class="pet-preview" id={id}>
	<PetClip id={id} width={pet.width} height={pet.height} />
</span>

<style>
	.pet-preview {
		display: grid;
		place-items: end center;
		width: 4rem;
		height: 4rem;
		border-radius: 0.625rem;
		background-color: var(--surface);
		scroll-margin-top: calc(var(--header-height) + 1.5rem);
	}
	.pet-preview :global(video) {
		display: block;
		max-width: 100%;
		max-height: 100%;
		object-fit: contain;
	}
	.pet-preview:target {
		outline: 2px solid var(--accent);
		outline-offset: 2px;
	}
</style>
