---
// Starlight's head, then what has to run before the page shows: the theme
// and language the reader chose, for the header's menus, and, when the
// language is automatic, the move to the page in the browser's language.
import Default from '@astrojs/starlight/components/Head.astro';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
// The 404 page answers every missing address, in either language; moving
// from it would only land on it again.
const is404 = Astro.locals.starlightRoute.entry.id === '404';
---

<Default />
<script is:inline define:vars={{ base, is404 }}>
	(() => {
		const root = document.documentElement;
		root.dataset.themeChoice = localStorage.getItem('starlight-theme') || 'auto';

		const choice = localStorage.getItem('site-language') || 'auto';
		root.dataset.languageChoice = choice;
		if (choice !== 'auto' || is404) return;
		const preferred = (navigator.languages || [navigator.language]).find((tag) => /^(en|zh)\b/i.test(tag)) || 'en';
		const want = preferred.toLowerCase().startsWith('zh') ? 'zh' : 'en';
		const have = root.lang.startsWith('zh') ? 'zh' : 'en';
		if (want === have) return;
		const path = location.pathname.slice(base.length).replace(/^\//, '');
		const other = have === 'zh' ? path.replace(/^zh\//, '') : `zh/${path}`;
		location.replace(`${base}/${other}${location.search}${location.hash}`);
	})();
</script>
