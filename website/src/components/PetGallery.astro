---
// A card for each pet the app ships, playing its idle clip at the size its
// manifest gives, so the pets keep their sizes relative to each other. Every
// card keeps its lines at the same places, so a row of cards lines up; the
// license leads to the pet's row in the docs.
import PetClip from './PetClip.astro';
import { loadPets } from '../pets';
import { url } from '../url';

interface Props {
	names: Record<string, string>;
	clips: (n: number) => string;
	nonCommercial: string;
	/** The docs page listing the pets' licenses, a row each by the pet's ID. */
	licenses: string;
}
const { names, clips, nonCommercial, licenses } = Astro.props;
const pets = loadPets();

// "owner/repo" of a source, as the README names it.
const sourceName = (href: string) => href.replace(/^https:\/\/github\.com\//, '');
---

<ul class="pets">
	{
		pets.map((pet) => (
			<li class="pet-card">
				<div class="pet-frame">
					<PetClip id={pet.id} width={pet.width} height={pet.height} style={`--w: ${pet.width}; --h: ${pet.height}`} />
					{pet.nonCommercial && <span class="tag">{nonCommercial}</span>}
				</div>
				<div class="pet-info">
					<h3>{names[pet.id] ?? pet.name}</h3>
					<p class="pet-meta">
						<code>{pet.id}</code>
						<span aria-hidden="true">·</span>
						<span>{clips(pet.clips)}</span>
					</p>
					<p class="pet-source" title={sourceName(pet.source)}>
						{sourceName(pet.source)}
					</p>
					<a class="pet-license" href={url(`${licenses}#${pet.id}`)}>
						{pet.license}
					</a>
				</div>
			</li>
		))
	}
</ul>

<style>
	.pets {
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(min(100%, 15rem), 1fr));
		gap: 1rem;
		margin: 0;
		padding: 0;
		list-style: none;
	}
	.pet-card {
		display: flex;
		flex-direction: column;
		min-width: 0;
		overflow: hidden;
		border: 1px solid var(--border);
		border-radius: var(--radius-lg);
		background-color: var(--bg);
		transition:
			transform 0.4s var(--ease),
			border-color 0.2s,
			box-shadow 0.4s var(--ease);
	}
	.pet-card:hover {
		transform: translateY(-2px);
		border-color: var(--border-strong);
		box-shadow: var(--shadow);
	}
	.pet-frame {
		position: relative;
		display: flex;
		align-items: flex-end;
		justify-content: center;
		height: 11rem;
		padding: 0.5rem;
		background:
			radial-gradient(60% 50% at 50% 70%, var(--accent-soft), transparent 70%),
			var(--surface);
	}
	/* The clip at 80% of its manifest's size, shrunk to fit the frame
	   whole; never cropped. */
	.pet-frame :global(video) {
		display: block;
		width: calc(var(--w) * 0.8px);
		max-width: 100%;
		height: 100%;
		max-height: calc(var(--h) * 0.8px);
		object-fit: contain;
		object-position: bottom;
	}
	.tag {
		position: absolute;
		top: 0.625rem;
		right: 0.625rem;
		padding: 0.125rem 0.5rem;
		border-radius: 999px;
		background-color: rgb(239 68 68 / 0.12);
		color: #ef4444;
		font-size: 0.6875rem;
		font-weight: 650;
		line-height: 1.4;
	}

	/* One line each for the name, its ID and clips and its source, then the
	   license in full, given two lines at least, so every card's lines sit
	   at the same heights. */
	.pet-info {
		display: grid;
		grid-template-rows: auto auto auto minmax(calc(2 * 1.5em), auto);
		align-content: start;
		gap: 0.375rem;
		padding: 1rem 1.125rem 1.125rem;
		font-size: 0.8125rem;
		line-height: 1.5;
	}
	.pet-info > * {
		min-width: 0;
		margin: 0;
		overflow: hidden;
		white-space: nowrap;
		text-overflow: ellipsis;
	}
	h3 {
		font-size: 1rem;
		font-weight: 650;
		letter-spacing: -0.01em;
		line-height: 1.5;
	}
	.pet-meta {
		color: var(--muted);
	}
	.pet-meta code {
		font-family: var(--font-mono);
		font-size: 0.75rem;
	}
	.pet-meta span[aria-hidden] {
		margin-inline: 0.375rem;
		color: var(--faint);
	}
	.pet-source {
		color: var(--muted);
	}
	.pet-info > .pet-license {
		overflow: visible;
		white-space: normal;
		overflow-wrap: anywhere;
		color: var(--faint);
		text-decoration: none;
		transition: color 0.15s;
	}
	.pet-license:hover {
		color: var(--accent);
		text-decoration: underline;
		text-underline-offset: 3px;
	}
	.pet-license:focus-visible {
		outline: 2px solid var(--accent);
		outline-offset: 2px;
		border-radius: 0.25rem;
	}
	@media (max-width: 35.99rem) {
		.pets {
			grid-template-columns: repeat(2, minmax(0, 1fr));
			gap: 0.625rem;
		}
		.pet-frame {
			height: 8.5rem;
			padding-top: 1rem;
		}
		.pet-info {
			padding: 0.75rem 0.875rem 0.875rem;
		}
	}
	@media (prefers-reduced-motion: reduce) {
		.pet-card {
			transition: none;
		}
	}
</style>
