---
// A link of the header's navigation that opens a menu of further links, as
// for the community's places. Every link in it leaves the site.
import { Icon } from '@astrojs/starlight/components';
import nsgoLogo from '../../assets/nsgo.svg?url';
import type { Link } from '../../copy';

interface Props {
	label: string;
	links: Link[];
}
const { label, links } = Astro.props;
---

<nav-menu class="nav-menu">
	<button type="button" class="nav-trigger" aria-haspopup="true" aria-expanded="false">
		{label}
		<Icon name="down-caret" size="1rem" class="caret" />
	</button>
	<ul class="nav-list" hidden>
		{
			links.map((link) => (
				<li>
					<a href={link.href} target="_blank" rel="noopener noreferrer">
						<span class="nav-icon">
							{link.icon === 'nsgo' ? <img src={nsgoLogo} alt="" width="18" height="18" /> : <Icon name={link.icon} size="1.05rem" />}
						</span>
						<span class="nav-text">
							<span>{link.label}</span>
							{link.note && <span class="nav-note">{link.note}</span>}
						</span>
						<Icon name="external" size="0.8rem" class="external" />
					</a>
				</li>
			))
		}
	</ul>
</nav-menu>

<script>
	class NavMenu extends HTMLElement {
		connectedCallback() {
			const trigger = this.querySelector<HTMLButtonElement>('.nav-trigger')!;
			const list = this.querySelector<HTMLElement>('.nav-list')!;
			const links = () => [...list.querySelectorAll<HTMLAnchorElement>('a')];
			const open = (focus = false) => {
				list.hidden = false;
				trigger.setAttribute('aria-expanded', 'true');
				if (focus) links()[0]?.focus();
			};
			const close = (refocus = false) => {
				if (list.hidden) return;
				list.hidden = true;
				trigger.setAttribute('aria-expanded', 'false');
				if (refocus) trigger.focus();
			};
			trigger.addEventListener('click', () => (list.hidden ? open() : close()));
			trigger.addEventListener('keydown', (e) => {
				if (e.key === 'ArrowDown') {
					e.preventDefault();
					open(true);
				}
			});
			list.addEventListener('keydown', (e) => {
				const all = links();
				const i = all.indexOf(document.activeElement as HTMLAnchorElement);
				if (e.key === 'ArrowDown' || e.key === 'ArrowUp') {
					e.preventDefault();
					all[(i + (e.key === 'ArrowDown' ? 1 : -1) + all.length) % all.length].focus();
				}
			});
			this.addEventListener('focusout', (e) => {
				if (!this.contains(e.relatedTarget as Node)) close();
			});
			this.addEventListener('keydown', (e) => {
				if (e.key === 'Escape') close(true);
			});
			document.addEventListener('pointerdown', (e) => {
				if (!this.contains(e.target as Node)) close();
			});
		}
	}
	customElements.define('nav-menu', NavMenu);
</script>

<style>
	.nav-menu {
		position: relative;
		display: block;
	}
	.nav-trigger {
		display: inline-flex;
		align-items: center;
		gap: 0.125rem;
		padding: 0.3125rem 0.375rem 0.3125rem 0.625rem;
		border: 0;
		border-radius: 0.625rem;
		background: none;
		color: var(--muted);
		font: inherit;
		font-size: 0.875rem;
		cursor: pointer;
		transition:
			color 0.15s,
			background-color 0.15s;
	}
	.nav-trigger:hover,
	.nav-trigger[aria-expanded='true'] {
		background-color: var(--surface);
		color: var(--text);
	}
	.nav-trigger:focus-visible {
		outline: 2px solid var(--accent);
		outline-offset: 1px;
	}
	.caret {
		transition: transform 0.2s var(--ease);
	}
	[aria-expanded='true'] .caret {
		transform: rotate(180deg);
	}

	.nav-list {
		position: absolute;
		top: calc(100% + 0.375rem);
		left: 0;
		z-index: 60;
		display: grid;
		min-width: 17rem;
		margin: 0;
		padding: 0.25rem;
		border: 1px solid var(--border);
		border-radius: 0.75rem;
		background-color: var(--bg);
		box-shadow:
			0 1px 2px rgb(0 0 0 / 0.06),
			0 12px 32px -8px rgb(0 0 0 / 0.2);
		list-style: none;
		transform-origin: top left;
		animation: nav-in 0.18s var(--ease);
	}
	.nav-list[hidden] {
		display: none;
	}
	@keyframes nav-in {
		from {
			opacity: 0;
			transform: scale(0.96) translateY(-4px);
		}
	}
	.nav-list a {
		display: flex;
		align-items: center;
		gap: 0.625rem;
		padding: 0.4375rem 0.5rem;
		border-radius: 0.5rem;
		color: var(--text);
		font-size: 0.8125rem;
		line-height: 1.3;
		text-decoration: none;
		outline: none;
	}
	.nav-list a:is(:hover, :focus-visible) {
		background-color: var(--surface-2);
	}
	.nav-icon {
		display: grid;
		flex: none;
		place-items: center;
		width: 1.75rem;
		height: 1.75rem;
		border-radius: 0.5rem;
		background-color: var(--surface);
		color: var(--text);
	}
	.nav-icon img {
		width: 1.125rem;
		height: 1.125rem;
	}
	.nav-text {
		display: grid;
		flex: 1;
		gap: 0.0625rem;
	}
	.nav-note {
		color: var(--muted);
		font-size: 0.75rem;
	}
	.external {
		color: var(--faint);
	}
	@media (prefers-reduced-motion: reduce) {
		.nav-list {
			animation: none;
		}
	}
</style>
